{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/callabens/LaunchyMind/schemas/launchpack.schema.json",
  "title": "LaunchPack",
  "description": "Schema version 1. Adding a field is compatible. Removing or renaming a required field bumps LaunchReport.version. Tool version 1.0.0-rc.1 is a release candidate, not 1.0.0.",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "product", "verdict", "disclaimers", "findings", "pack", "facts"],
  "properties": {
    "version": { "const": 1 },
    "product": { "const": "LaunchyMind" },
    "verdict": { "enum": ["ready", "risky", "reject"] },
    "disclaimers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "findings": { "type": "array" },
    "pack": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "facts": { "type": "object" }
  }
}
