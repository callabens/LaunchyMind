{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/callabens/LaunchyMind/registry/index.schema.json",
  "title": "LaunchyMind pack registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packs"],
  "properties": {
    "schema": { "const": 1 },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "repository", "path", "commit", "integrity"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 10 },
          "repository": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^registry/packs/[a-z0-9-]+$" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
